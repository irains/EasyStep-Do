{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "行简",
  "version": "1.0.3",
  "identifier": "cn.rainss.easystepdo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "行简",
        "width": 900,
        "height": 786,
        "minWidth": 820,
        "minHeight": 640,
        "resizable": false,
        "maximizable": false,
        "decorations": true,
        "shadow": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "浅语",
    "targets": "all",
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
